{{ 'section-page-hero.css' | asset_url | stylesheet_tag }}

<section
  class="page-hero"
  style="
    --page-hero-background: {{ section.settings.background_color }};
    --page-hero-radius: {{ section.settings.border_radius }}px;
    --page-hero-padding-top: {{ section.settings.padding_top }}px;
    --page-hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --page-hero-content-width: {{ section.settings.content_width }}px;
    --page-hero-image-width: {{ section.settings.image_width }}px;
    --page-hero-breadcrumb-color: {{ section.settings.breadcrumb_color }};
    --page-hero-breadcrumb-size: {{ section.settings.breadcrumb_size }}px;
    --page-hero-heading-color: {{ section.settings.heading_color }};
    --page-hero-heading-size: {{ section.settings.heading_size }}px;
    --page-hero-description-color: {{ section.settings.description_color }};
    --page-hero-description-size: {{ section.settings.description_size }}px;
  "
>

  <div class="page-hero__container">

    <div class="page-hero__wrapper">

      <div class="page-hero__content {% if section.settings.image_position == 'left' %}page-hero__content--reverse{% endif %}">

        <div
          class="page-hero__text"
          style="max-width: var(--page-hero-content-width);"
        >

          {% if section.settings.breadcrumb != blank %}
            <div class="page-hero__breadcrumb">
              {% render 'breadcrumb' %}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1 class="page-hero__heading">
              {{ section.settings.heading }}
            </h1>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="page-hero__description">
              {{ section.settings.description }}
            </div>
          {% endif %}

        </div>

        <div
          class="page-hero__image"
          style="max-width: var(--page-hero-image-width);"
        >

          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 800
              | image_tag:
                class: 'page-hero__image-element',
                loading: 'lazy'
            }}
          {% endif %}

        </div>

      </div>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Page Hero",
  "tag": "section",
  "class": "section-page-hero",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#182941"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Width",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 830
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width",
      "min": 200,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 350
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Breadcrumb",
      "default": "Home / About"
    },
    {
      "type": "color",
      "id": "breadcrumb_color",
      "label": "Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "breadcrumb_size",
      "label": "Font Size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Stengler"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font Size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Doctor-formulated solutions based on decades of clinical experience and modern research.</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Font Size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Page Hero"
    }
  ]
}
{% endschema %}