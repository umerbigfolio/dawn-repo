{{ 'section-reviews-slider.css' | asset_url | stylesheet_tag }}
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
/>

<section
  class="reviews-slider"
  style="
    --reviews-slider-padding-top: {{ section.settings.padding_top }}px;
    --reviews-slider-padding-bottom: {{ section.settings.padding_bottom }}px;
    --reviews-slider-heading-color: {{ section.settings.heading_color }};
    --reviews-slider-heading-size: {{ section.settings.heading_size }}px;
    --reviews-slider-text-color: {{ section.settings.text_color }};
    --reviews-slider-text-size: {{ section.settings.text_size }}px;
    --reviews-slider-card-background: {{ section.settings.card_background }};
    --reviews-slider-card-text-color: {{ section.settings.card_text_color }};
    --reviews-slider-card-radius: {{ section.settings.card_radius }}px;
    --reviews-slider-date-size: {{ section.settings.date_size }}px;
    --reviews-slider-author-size: {{ section.settings.author_size }}px;
  "
>
  <div class="reviews-slider__container">
    <div class="reviews-slider__header">
      {% if section.settings.heading != blank %}
        <h2 class="reviews-slider__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="reviews-slider__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
    <div class="reviews-slider__content">
      <div class="reviews-slider__swiper swiper"
        data-desktop="{{ section.settings.desktop_slides }}"
        data-tablet="{{ section.settings.tablet_slides }}"
        data-mobile="{{ section.settings.mobile_slides }}"
        data-gap="{{ section.settings.space_between }}"
      >
        <div class="reviews-slider__wrapper swiper-wrapper">
          {% for block in section.blocks %}
            <div
              class="reviews-slider__slide swiper-slide"
              {{ block.shopify_attributes }}
            >
              <article class="review-card">
                <div class="review-card__header">
                  <div class="review-card__stars">
                    {% assign rating = block.settings.rating | plus: 0 %}
                    {% for i in (1..5) %}
                      {% if i <= rating %}
                        ★
                      {% else %}
                        ☆
                      {% endif %}
                    {% endfor %}
                  </div>
                  <div class="review-card__date">
                    {{ block.settings.review_date }}
                  </div>
                </div>
                <div class="review-card__content">
                  {{ block.settings.review }}
                </div>
                <div class="review-card__footer">
                  <div class="review-card__author">
                    {{ block.settings.author }}
                  </div>
                  {% if block.settings.author_image != blank %}
                    <div class="review-card__author-image">
                      {{
                        block.settings.author_image
                        | image_url: width: 96
                        | image_tag:
                          class: 'review-card__author-image-element',
                          loading: 'lazy'
                      }}
                    </div>
                  {% endif %}
                </div>
              </article>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="reviews-slider__pagination swiper-pagination"></div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
{{ 'section-reviews-slider.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Reviews Slider",
  "tag": "section",
  "class": "section-reviews-slider",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted By 100+ People"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#182941"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>These are the same formulas used in our clinic to support real patients.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Color",
      "default": "#182941"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description Size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Review Cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#182941"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#F3F3F3"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "date_size",
      "label": "Review Date Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "review_size",
      "label": "Review Text Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "author_size",
      "label": "Author Name Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_slides",
      "label": "Desktop Slides",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_slides",
      "label": "Tablet Slides",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_slides",
      "label": "Mobile Slides",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "space_between",
      "label": "Space Between",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Review Date",
          "default": "24-Sep-2025"
        },
        {
          "type": "richtext",
          "id": "review",
          "label": "Review",
          "default": "<p>I've been using this wellness product daily, and I already feel more energetic and refreshed. It fits perfectly into my routine.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sara Wellness"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Slider",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}