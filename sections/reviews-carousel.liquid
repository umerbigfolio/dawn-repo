{{ 'section-reviews-carousel.css' | asset_url | stylesheet_tag }}


<reviews-carousel
  class="reviews-carousel"
  data-desktop="{{ section.settings.desktop_slides }}"
  data-tablet="{{ section.settings.tablet_slides }}"
  data-mobile="{{ section.settings.mobile_slides }}"
  style="
    --reviews-carousel-padding-top: {{ section.settings.padding_top }}px;
    --reviews-carousel-padding-bottom: {{ section.settings.padding_bottom }}px;
    --reviews-carousel-heading-color: {{ section.settings.heading_color }};
    --reviews-carousel-heading-size: {{ section.settings.heading_size }}px;
    --reviews-carousel-text-color: {{ section.settings.text_color }};
    --reviews-carousel-text-size: {{ section.settings.text_size }}px;
    --reviews-carousel-card-background: {{ section.settings.card_background }};
    --reviews-carousel-card-text-color: {{ section.settings.card_text_color }};
    --reviews-carousel-card-radius: {{ section.settings.card_radius }}px;
    --reviews-carousel-date-size: {{ section.settings.date_size }}px;
    --reviews-carousel-review-size: {{ section.settings.review_size }}px;
    --reviews-carousel-author-size: {{ section.settings.author_size }}px;
    --reviews-carousel-card-gap: {{ section.settings.card_gap }}px;
    --reviews-carousel-edge-padding: {{ section.settings.edge_padding }}px;
    --reviews-carousel-card-width-desktop: {{ section.settings.desktop_card_width }}px;
    --reviews-carousel-card-width-tablet: {{ section.settings.tablet_card_width }}px;
    --reviews-carousel-card-width-mobile: {{ section.settings.mobile_card_width }}px;
  "
>
  <div class="reviews-carousel__container">

    <div class="reviews-carousel__header">

      {% if section.settings.heading != blank %}
        <h2 class="reviews-carousel__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="reviews-carousel__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>

    <div class="reviews-carousel__slider">

      <button
        class="reviews-carousel__button reviews-carousel__button--prev"
        type="button"
        data-prev
      >
        ←
      </button>

      <div
        class="reviews-carousel__track"
        data-reviews-track
      >

        {% for block in section.blocks %}

          <div
            class="reviews-carousel__slide"
            data-review-slide
            {{ block.shopify_attributes }}
          >

            <article class="review-card">

              <div class="review-card__header">

                <div class="review-card__stars">

                  {% assign rating = block.settings.rating | plus: 0 %}

                  {% for i in (1..5) %}
                    {% if i <= rating %}
                      ★
                    {% else %}
                      ☆
                    {% endif %}
                  {% endfor %}

                </div>

                <div class="review-card__date">
                  {{ block.settings.review_date }}
                </div>

              </div>

              <div class="review-card__content">
                {{ block.settings.review }}
              </div>

              <div class="review-card__footer">

                <div class="review-card__author">
                  {{ block.settings.author }}
                </div>

                {% if block.settings.author_image != blank %}

                  <div class="review-card__author-image">

                    {{
                      block.settings.author_image
                      | image_url: width: 96
                      | image_tag:
                        class: 'review-card__author-image-element',
                        loading: 'lazy'
                    }}

                  </div>

                {% endif %}

              </div>

            </article>

          </div>

        {% endfor %}

      </div>

      <button
        class="reviews-carousel__button reviews-carousel__button--next"
        type="button"
        data-next
      >
        →
      </button>

    </div>

    <div
      class="reviews-carousel__pagination"
      data-pagination
    ></div>

  </div>

</reviews-carousel>
{{ 'reviews-carousel.js' | asset_url | script_tag }}
{% schema %}
{
  "name": "Reviews Carousel",
  "tag": "section",
  "class": "section-reviews-carousel",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted By 100+ People"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#182941"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>These are the same formulas used in our clinic to support real patients.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Color",
      "default": "#182941"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description Size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Review Cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#182941"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#F3F3F3"
    },
