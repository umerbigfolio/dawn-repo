  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Review Date",
          "default": "24 Sep 2025"
        },
        {
          "type": "richtext",
          "id": "review",
          "label": "Review",
          "default": "<p>I've been using this wellness product daily, and I already feel more energetic and refreshed. It fits perfectly into my routine.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sara Wellness"
        },
        {
