{{ 'section-content-media.css' | asset_url | stylesheet_tag }}

<section
  class="content-media"
  style="
    --content-media-background: {{ section.settings.background_color }};
    --content-media-radius: {{ section.settings.border_radius }}px;
    --content-media-padding-top: {{ section.settings.padding_top }}px;
    --content-media-padding-bottom: {{ section.settings.padding_bottom }}px;
    --content-media-image-width: {{ section.settings.image_width }}px;
    --content-media-text-width: {{ section.settings.text_width }}px;
    --content-media-image-radius: {{ section.settings.image_radius }}px;
    --content-media-column-gap: {{ section.settings.column_gap }}px;
    --content-media-heading-color: {{ section.settings.heading_color }};
    --content-media-heading-size: {{ section.settings.heading_size }}px;
    --content-media-description-color: {{ section.settings.description_color }};
    --content-media-description-size: {{ section.settings.description_size }}px;
  "
>

  <div class="content-media__container">

    <div class="content-media__wrapper">

      <div class="content-media__content {% if section.settings.image_position == 'right' %}content-media__content--reverse{% endif %}">

        <div
          class="content-media__image"
          style="max-width: var(--content-media-image-width);"
        >

          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                class: 'content-media__image-element',
                loading: 'lazy'
            }}
          {% endif %}

        </div>

        <div
          class="content-media__text"
          style="max-width: var(--content-media-text-width);"
        >

          {% if section.settings.heading != blank %}
            <h2 class="content-media__heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="content-media__description">
              {{ section.settings.description }}
            </div>
          {% endif %}

        </div>

      </div>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Content Media",
  "tag": "section",
  "class": "section-content-media",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F3F3F3"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
        "type": "range",
        "id": "image_width",
        "label": "Image Width",
        "min": 300,
        "max": 1000,
        "step": 10,
        "unit": "px",
        "default": 820
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text Width",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 410
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#182941"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 24,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#182941"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Content Media"
    }
  ]
}
{% endschema %}